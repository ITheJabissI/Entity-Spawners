local P = game:GetService("Players")
local R = game:GetService("ReplicatedStorage")
local p = P.LocalPlayer

local spawn = Instance.new("Sound", workspace)
spawn.SoundId = "rbxassetid://715673747"
spawn.Volume = 5
spawn:Play()

task.wait(23)

local g = game:GetObjects("rbxassetid://15104414692")[1]
if not g then return end
g.Parent = workspace

local x = g:FindFirstChildWhichIsA("BasePart")
local rooms = workspace.CurrentRooms:GetChildren()
x.CFrame = rooms[#rooms - 1].Parts.Floor.CFrame + Vector3.new(0, 4, 0)

local h = p.Character:FindFirstChildOfClass("Humanoid")

local d = Instance.new("Sound", p.Character)
d.SoundId = "rbxassetid://6664373487"
d.Volume = 1

task.spawn(function()
	while g.Parent do
		task.wait(.1)

		local _, visible = workspace.CurrentCamera:WorldToViewportPoint(x.Position)

		if not visible then
			h:TakeDamage(5)
			d:Play()
			img.Visible = true
			task.delay(1, function()
				img.Visible = false
			end)
		end

		if h.Health <= 0 then
			firesignal(R.RemotesFolder.DeathHint.OnClientEvent, {
				"You died to who you call Hunger...",
				"He spawns in center of room and damages you if you dont look at him/",
				"He doesn't like to be ignored."
			}, "Blue")

			R.GameStats["Player_" .. p.Name].Total.DeathCause.Value = "Hunger"
		end
	end
end)

R.GameData.LatestRoom.Changed:Wait()
g:Destroy()
