local function CheckRoomCallback(node)

	if not node then
		return
	end

	local room =
		node:FindFirstAncestorWhichIsA(
			"Model"
		)

	if not room then
		return
	end

	if not room:FindFirstChild(
		"Nodes"
	) then
		return
	end

	if LastRoom ~= room then

		local firstTime =
			LastRoom == nil

		LastRoom =
			room

		FireCallback(
			"OnEnterRoom",
			room,
			firstTime
		)

	end

end

