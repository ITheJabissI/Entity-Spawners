local function loadRobloxAsset(assetId)

	print("[ENTITY] Loading Roblox asset:")
	print(assetId)

	--==========================================================
	-- METHOD 1: GetObjects
	--==========================================================

	local success, objects =
		pcall(function()

			return game:GetObjects(assetId)

		end)

	if success
		and objects
		and #objects > 0 then

		print(
			"[ENTITY] GetObjects loaded:",
			#objects,
			"objects."
		)

		local model = nil

		for _, object in ipairs(objects) do

			if object:IsA("Model") then
				model = object
				break
			end

		end

		if model then
			return model
		end

		return objects[1]

	end

	warn(
		"[ENTITY] GetObjects failed:",
		objects
	)

	--==========================================================
	-- METHOD 2: InsertService
	--==========================================================

	local assetNumber =
		string.match(
			assetId,
			"(%d+)"
		)

	if not assetNumber then

		warn(
			"[ENTITY] Could not extract asset ID."
		)

		return nil

	end

	local assetIdNumber =
		tonumber(assetNumber)

	if not assetIdNumber then
		return nil
	end

	local insertSuccess, container =
		pcall(function()

			return InsertService:LoadAsset(
				assetIdNumber
			)

		end)

	if insertSuccess
		and container then

		print(
			"[ENTITY] InsertService loaded asset."
		)

		local model = nil

		for _, object in ipairs(
			container:GetChildren()
		) do

			if object:IsA("Model") then
				model = object
				break
			end

		end

		if model then

			model.Parent = Workspace

			return model

		end

		local first =
			container:GetChildren()[1]

		if first then

			first.Parent = Workspace

			return first

		end

	end

	warn(
		"[ENTITY] InsertService also failed:",
		container
	)

	return nil

end

--==============================================================
-- GITHUB RBXM LOADER
--==============================================================

local function loadGitHubRBXM(url)

	print("[ENTITY] Downloading RBXM:")
	print(url)

	local success, data =
		pcall(function()

			return game:HttpGet(url)

		end)

	if not success then

		warn(
			"[ENTITY] GitHub download failed:",
			data
		)

		return nil

	end

	if not data
		or #data == 0 then

		warn(
			"[ENTITY] GitHub returned empty data."
		)

		return nil

	end

	print(
		"[ENTITY] RBXM downloaded:",
		#data,
		"bytes"
	)

	--==========================================================
	-- SerializationService
	--==========================================================

	local SerializationService =
		game:GetService(
			"SerializationService"
		)

	if not SerializationService then

		warn(
			"[ENTITY] SerializationService unavailable."
		)

		return nil

	end

	local bufferSuccess, bufferData =
		pcall(function()

			return buffer.fromstring(data)

		end)

	if not bufferSuccess then

		warn(
			"[ENTITY] Buffer conversion failed:",
			bufferData
		)

		return nil

	end

	local deserializeSuccess, objects =
		pcall(function()

			return SerializationService:
				DeserializeInstancesAsync(
					bufferData
				)

		end)

	if not deserializeSuccess then

		warn(
			"[ENTITY] RBXM deserialization failed:",
			objects
		)

		return nil

	end

	if not objects
		or #objects == 0 then

		warn(
			"[ENTITY] RBXM contained no objects."
		)

		return nil

	end

	for _, object in ipairs(objects) do

		if object:IsA("Model") then
			return object
		end

	end

	return objects[1]

end

--==============================================================
-- UNIVERSAL LOADER
--==============================================================

local function LoadEntity(asset)

	if not asset then
		return nil
	end

	if string.match(
		asset,
		"^rbxassetid://"
	) then

		return loadRobloxAsset(asset)

	end

	if string.match(
		asset,
		"^https://"
	)
	or string.match(
		asset,
		"^http://"
	) then

		return loadGitHubRBXM(asset)

	end

	warn(
		"[ENTITY] Unsupported asset:",
		asset
	)

	return nil

end

