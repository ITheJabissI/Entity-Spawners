--==============================================================
-- MOVE TO NODE
--==============================================================

local function MoveToNode(target)

	if not target
		or not target.Parent then

		return true

	end

	local StartPivot =
		Figure:GetPivot()

	local TargetPosition =
		target.Position
		+
		MOVEMENT_OFFSET

	local distance =
		(
			StartPivot.Position
			-
			TargetPosition
		).Magnitude

	local TravelTime =
		math.max(
			distance / SPEED,
			0.03
		)

	local startTime =
		time()

	while true do

		if not Figure
			or not Figure.Parent then

			return false

		end

		if KillTriggered then
			return false
		end

		local Alpha =
			math.clamp(
				(
					time()
					-
					startTime
				)
				/
				TravelTime,
				0,
				1
			)

		local Position =
			StartPivot.Position:Lerp(
				TargetPosition,
				Alpha
			)

		Figure:PivotTo(
			CFrame.new(
				Position
			)
			*
			StartPivot.Rotation
		)

		if Alpha >= 1 then
			break
		end

		RunService.Heartbeat:Wait()

	end

	CheckRoomCallback(
		target
	)

	return true

end

--==============================================================
-- MOVE THROUGH TARGETS
--==============================================================

local function MoveThroughTargets(list)

	for _, target in ipairs(list) do

		if KillTriggered then
			return false
		end

		if not MoveToNode(target) then
			return false
		end

	end

	return true

end

