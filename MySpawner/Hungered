--==============================================================

task.spawn(function()

	while Figure
		and Figure.Parent do

		if CAMERA_SHAKE_ENABLED
			and CamShake
			and HRP
			and HRP.Parent then

			local distance =
				(
					Figure:GetPivot().Position
					-
					HRP.Position
				).Magnitude

			if distance
				<= CAMERA_SHAKE_DISTANCE then

				pcall(function()

					CamShake:ShakeOnce(
						CAMERA_SHAKE_MAGNITUDE,
						CAMERA_SHAKE_ROUGHNESS,
						CAMERA_SHAKE_FADE_IN,
						CAMERA_SHAKE_FADE_OUT
					)

				end)

			end

		end

		task.wait(
			CAMERA_SHAKE_INTERVAL
		)

	end

end)

--==============================================================
-- LOOK DETECTION
--==============================================================

task.spawn(function()

	while Figure
		and Figure.Parent
		and not Despawned do

		local Camera =
			Workspace.CurrentCamera

		if Camera then

			local Origin =
				Camera.CFrame.Position

			local Direction =
				Figure:GetPivot().Position
				-
				Origin

			if Direction.Magnitude > 0 then

				local RayParams =
					RaycastParams.new()

				RayParams.FilterType =
					Enum.RaycastFilterType.Exclude

				RayParams.FilterDescendantsInstances = {
					Character
				}

				local Result =
					Workspace:Raycast(
						Origin,
						Direction,
						RayParams
					)

				local Looking =
					Result
					and Result.Instance
					and Result.Instance:IsDescendantOf(
						Figure
					)
					or false

				if Looking ~= LastLookAt then

					LastLookAt =
						Looking

					FireCallback(
						"OnLookAt",
						Looking
					)

				end

			end

		end

		RunService.Heartbeat:Wait()

	end

end)

