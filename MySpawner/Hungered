--==============================================================
-- CALLBACK SYSTEM
--==============================================================

local Callbacks = {}

local function SetCallback(name, callback)

	if typeof(name) ~= "string" then
		warn("[ENTITY] Callback name must be a string.")
		return
	end

	if typeof(callback) ~= "function" then
		warn("[ENTITY] Callback must be a function.")
		return
	end

	Callbacks[name] = callback

end

local function FireCallback(name, ...)

	local callback = Callbacks[name]

	if not callback then
		return
	end

	local success, err =
		pcall(callback, ...)

	if not success then
		warn(
			"[ENTITY] Callback error [" ..
				name ..
				"]:",
			err
		)
	end

end

