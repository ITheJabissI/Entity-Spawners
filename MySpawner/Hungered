--==============================================================

local function GetNodes(room)

	if not room then
		return {}
	end

	local NodesFolder =
		room:FindFirstChild(
			"Nodes"
		)

	if not NodesFolder then
		return {}
	end

	local nodes = {}

	for _, node in ipairs(
		NodesFolder:GetChildren()
	) do

		if node:IsA("BasePart") then

			table.insert(
				nodes,
				node
			)

		end

	end

	table.sort(
		nodes,
		function(a, b)

			local A =
				tonumber(a.Name)

			local B =
				tonumber(b.Name)

			if A and B then
				return A < B
			end

			if A then
				return true
			end

			if B then
				return false
			end

			return a.Name < b.Name

		end
	)

	return nodes

end

