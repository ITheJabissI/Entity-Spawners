		"OnStartMoving",
		Figure
	)

end

--==============================================================
-- FIRST PASS
--==============================================================

local Completed =
	MoveThroughTargets(
		Targets
	)

--==============================================================
-- REBOUNDS
--==============================================================

if Completed
	and not KillTriggered
	and REBOUNDS > 0 then

	for rebound = 1, REBOUNDS do

		if KillTriggered then
			break
		end

		task.wait(
			REBOUND_DELAY
		)

		FireCallback(
			"OnRebounding",
			true
		)

		local ReverseTargets = {}

		for i =
			#Targets,
			1,
			-1
		do

			table.insert(
				ReverseTargets,
				Targets[i]
			)

		end

		local ReverseCompleted =
			MoveThroughTargets(
				ReverseTargets
			)

		FireCallback(
			"OnRebounding",
			false
		)

		if not ReverseCompleted then
			break
		end

		if rebound < REBOUNDS then

			task.wait(
				REBOUND_DELAY
			)

			local ForwardCompleted =
				MoveThroughTargets(
					Targets
				)

			if not ForwardCompleted then
				break
			end

		end

	end

end

