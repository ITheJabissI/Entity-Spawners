local function GetLights(room)

	local lights = {}

	for _, object in ipairs(
		room:GetDescendants()
	) do

		if object:IsA("PointLight")
			or object:IsA("SpotLight")
			or object:IsA("SurfaceLight") then

			table.insert(
				lights,
				object
			)

		end

	end

	return lights

end

local function FlickerLights(room)

	if not FLICKER_LIGHTS then
		return
	end

	local lights =
		GetLights(room)

	local original = {}

	for _, light in ipairs(lights) do

		original[light] =
			light.Enabled

	end

	local startTime =
		time()

	while
		time() - startTime
		<
		FLICKER_DURATION
	do

		for _, light in ipairs(lights) do

			if light
				and light.Parent then

				light.Enabled =
					math.random(
						1,
						2
					)
					==
					1

			end

		end

		task.wait(
			FLICKER_SPEED
		)

	end

	for _, light in ipairs(lights) do

		if light
			and light.Parent then

			light.Enabled =
				original[light]

		end

	end

end

