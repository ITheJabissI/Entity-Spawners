--====== Spawned ======--

entity:SetCallback("OnSpawned", function()
	print("Torment has spawned")

	-- Show futuristic caption
	ShowTormentCaption()

	-- Load Torment's voice
	if not TormentSound then
		TormentSound = GetGitSound(
			"https://github.com/ITheJabissI/Entity-Spawners/raw/main/FragmentedModeV6/Unknown%20HUG.ogg",
			"Torment"
		)
	end

	if TormentSound then
		TormentSound.Parent = workspace
		TormentSound.Volume = 3.5
		TormentSound.Name = "TormentVoice"
		TormentSound.PlaybackSpeed = 1
		TormentSound:Play()
	end
end)


--====== Start Moving ======--

entity:SetCallback("OnStartMoving", function()
	print("Torment has started moving")
end)


--====== Enter Room ======--

entity:SetCallback("OnEnterRoom", function(room: Model, firstTime: boolean)
	if firstTime then
		print("Torment entered room for the first time: " .. room.Name)
	else
		print("Torment entered room again: " .. room.Name)
	end
end)


--====== Look At ======--

entity:SetCallback("OnLookAt", function(lineOfSight: boolean)
	if lineOfSight then
		print("Player is looking at Torment")
	else
		print("Player view is obstructed")
	end
end)


--====== Rebounding ======--

entity:SetCallback("OnRebounding", function(startOfRebound: boolean)
	if startOfRebound then
		print("Torment has started rebounding")
	else
		print("Torment has finished rebounding")
	end
end)


--====== Damage Player ======--

entity:SetCallback("OnDamagePlayer", function(newHealth: number)
	if newHealth <= 0 then
		print("Torment has killed the player")

		PlayDeathSequence()
	else
		print("Torment damaged the player")
	end
end)


--====== Despawning ======--

entity:SetCallback("OnDespawning", function()
	print("Torment is despawning")

	-- Stop voice
	if TormentSound then
		TormentSound:Stop()
		TormentSound:Destroy()
		TormentSound = nil
	end

	-- Safely remove entity model if it still exists
	local TormentModel = workspace:FindFirstChild("Torment")

	if TormentModel then
		local Main = TormentModel:FindFirstChild("Main")

		if Main then
			Main:Destroy()
		end
	end

	local achievementGiver = loadstring(game:HttpGet(
		"https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"
	))()

	achievementGiver({
		Title = "Stalking Game",
		Desc = "Im watching you...",
		Reason = "Encounter Torment",

		-- Your GitHub image
		Image = "https://github.com/ITheJabissI/Entity-Spawners/raw/main/FragmentedModeV6/2026_08_13_000_Kleki.png"
	})
end)
		warn("Failed to load achievement giver")
	end
end)


--====== Despawned ======--

entity:SetCallback("OnDespawned", function()
	print("Torment has despawned")

	DeathSequencePlaying = false
end)


