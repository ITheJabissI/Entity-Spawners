--====== Load Spawner ======--

local Spawner = loadstring(game:HttpGet(
	"https://raw.githubusercontent.com/RegularVynixu/DOORS-Entity-Spawner-V2/main/init.luau"
))()

--====== Services ======--

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

--====== State ======--

local DeathSequencePlaying = false
local TormentSound = nil

--========================================================--
--                  HELPER FUNCTIONS                     --
--========================================================--

--====== Caption ======--

local function ShowTormentCaption()
	local MainUI = PlayerGui:FindFirstChild("MainUI")
	if not MainUI then
		return
	end

	local Initiator = MainUI:FindFirstChild("Initiator")
	if not Initiator then
		return
	end

	local MainGameModule = Initiator:FindFirstChild("Main_Game")
	if not MainGameModule then
		return
	end

	local Main_Game = require(MainGameModule)

	Main_Game.caption(
		"Something stops you from running...",
		true
	)

	-- Caption can be created a tiny bit after caption()
	-- so wait for it before styling it.
	task.defer(function()
		task.wait()

		for _, object in ipairs(MainUI:GetDescendants()) do
			if object:IsA("TextLabel")
				and object.Text == "Something stops you from running..." then

				object.Font = Enum.Font.SciFi
				object.TextSize = 18
				object.TextTransparency = 0
				object.TextStrokeTransparency = 1
			end
		end
	end)
end


--====== Download / Load Sound ======--

local function GetGitSound(GithubURL, SoundName)
	local FileName = SoundName .. ".ogg"

	if not isfile(FileName) then
		local AudioData = game:HttpGet(GithubURL)
		writefile(FileName, AudioData)
	end

	local AssetLoader = getcustomasset or getsynasset

	if not AssetLoader then
		warn("Custom asset function is not supported by this executor.")
		return nil
	end

	local Sound = Instance.new("Sound")
	Sound.SoundId = AssetLoader(FileName)

	return Sound
end


--====== Destroy Existing Torment UI ======--

local function CleanupDeathUI()
	local ExistingUI = PlayerGui:FindFirstChild("TormentDeathScreen")

	if ExistingUI then
		ExistingUI:Destroy()
	end
end


--========================================================--
--                  DEATH JUMPSCARE                      --
--========================================================--

local function PlayDeathSequence()
	-- Prevent the sequence from running twice
	if DeathSequencePlaying then
		return
	end

	DeathSequencePlaying = true

	local Character = Player.Character
	local Humanoid = Character and Character:FindFirstChildWhichIsA("Humanoid")
	local Camera = workspace.CurrentCamera

	if not Camera then
		DeathSequencePlaying = false
		return
	end

	CleanupDeathUI()

	--====== Screen GUI ======--

	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "TormentDeathScreen"
	ScreenGui.IgnoreGuiInset = true
	ScreenGui.ResetOnSpawn = false
	ScreenGui.DisplayOrder = 999999
	ScreenGui.Parent = PlayerGui

	--====== State ======--

	local StopEffects = false

	--====== Background ======--

	local Background = Instance.new("ImageLabel")
	Background.Name = "Background"
	Background.Size = UDim2.fromScale(1, 1)
	Background.Position = UDim2.fromScale(0, 0)
	Background.BackgroundColor3 = Color3.new(0, 0, 0)
	Background.BackgroundTransparency = 0
	Background.Image = "rbxassetid://1712510813"
	Background.ImageTransparency = 0.5
	Background.BorderSizePixel = 0
	Background.Parent = ScreenGui

	--====== Face ======--

	local Face = Instance.new("ImageLabel")
	Face.Name = "Face"
	Face.AnchorPoint = Vector2.new(0.5, 0.5)
	Face.Position = UDim2.fromScale(0.5, 0.589)
	Face.Size = UDim2.fromOffset(30, 30)
	Face.BackgroundTransparency = 1
	Face.Image = "rbxassetid://11395249132"
	Face.Parent = ScreenGui

	--====== Text ======--

	local Text = Instance.new("ImageLabel")
	Text.Name = "GlitchText"
	Text.AnchorPoint = Vector2.new(0.5, 0.5)
	Text.Position = UDim2.fromScale(0.5, 0.5)
	Text.Size = UDim2.fromOffset(150, 150)
	Text.BackgroundTransparency = 1
	Text.Image = "rbxassetid://99132041298170"
	Text.Parent = ScreenGui

	--====================================================--
	--                  DEATH SOUND                       --
	--====================================================--

	local KillSound = Instance.new("Sound")
	KillSound.Name = "TormentDeathSound"
	KillSound.SoundId = "rbxassetid://18459521002"
	KillSound.Volume = 10
	KillSound.PlaybackSpeed = 1
	KillSound.Looped = true
	KillSound.Parent = workspace

	-- Sound effects
	local Flange = Instance.new("FlangeSoundEffect")
	Flange.Rate = 0.2
	Flange.Parent = KillSound

	local Tremolo = Instance.new("TremoloSoundEffect")
	Tremolo.Frequency = 1
	Tremolo.Parent = KillSound

	local Pitch = Instance.new("PitchShiftSoundEffect")
	Pitch.Octave = 1
	Pitch.Parent = KillSound

	local Distortion = Instance.new("DistortionSoundEffect")
	Distortion.Level = 0.2
	Distortion.Parent = KillSound

	KillSound:Play()

	--====================================================--
	--                  CAMERA EFFECT                     --
	--====================================================--

	local StartFOV = Camera.FieldOfView
	local ZoomFOV = 60
	local ZoomDuration = 1.1

	Camera.CameraType = Enum.CameraType.Scriptable

	TweenService:Create(
		Camera,
		TweenInfo.new(
			ZoomDuration,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			FieldOfView = ZoomFOV
		}
	):Play()

	-- Face zoom
	TweenService:Create(
		Face,
		TweenInfo.new(
			ZoomDuration,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			Size = UDim2.fromOffset(1200, 1200),
			Position = UDim2.fromScale(0.5, 0.5)
		}
	):Play()

	--====================================================--
	--                 GLITCH EFFECTS                     --
	--====================================================--

	-- Background flash
	task.spawn(function()
		while not StopEffects do
			Background.ImageTransparency = 0.3
			Background.BackgroundTransparency = 0

			task.wait(0.1)

			if StopEffects then
				break
			end

			Background.ImageTransparency = 0
			Background.BackgroundTransparency = 0.3

			task.wait(0.1)
		end
	end)


	-- Background image flicker
	task.spawn(function()
		while not StopEffects do
			Background.Image = "rbxassetid://131073231978514"

			task.wait(0.0589)

			if StopEffects then
				break
			end

			Background.Image = "rbxassetid://105841646930424"

			task.wait(0.0589)
		end
	end)


	-- Face shaking
	task.spawn(function()
		while not StopEffects do
			Face.Rotation = 10
			Face.Image = "rbxassetid://132219569139802"

			task.wait(0.03)

			if StopEffects then
				break
			end

			Face.Rotation = -10

			task.wait(0.03)
		end
	end)


	-- Text image flicker
	task.spawn(function()
		while not StopEffects do
			Text.Image = "rbxassetid://88490592395124"

			task.wait(0.0589)

			if StopEffects then
				break
			end

			Text.Image = "rbxassetid://99132041298170"

			task.wait(0.0589)
		end
	end)


	-- Random text position
	task.spawn(function()
		while not StopEffects do
			Text.Position = UDim2.new(
				math.random(10, 90) / 100,
				0,
				math.random(10, 90) / 100,
				0
			)

			task.wait(0.05)
		end
	end)


	-- Text blinking
	task.spawn(function()
		while not StopEffects do
			Text.ImageTransparency = 0

			task.wait(0.1)

			if StopEffects then
				break
			end

			Text.ImageTransparency = 1

			task.wait(0.1)
		end
	end)

	--====================================================--
	--                    FADE OUT                       --
	--====================================================--

	task.wait(ZoomDuration)

	StopEffects = true

	KillSound:Stop()
	KillSound:Destroy()

	-- Fade everything
	local FadeDuration = 0.5

	TweenService:Create(
		Face,
		TweenInfo.new(FadeDuration),
		{
			ImageTransparency = 1
		}
	):Play()

	TweenService:Create(
		Text,
		TweenInfo.new(FadeDuration),
		{
			ImageTransparency = 1
		}
	):Play()

	TweenService:Create(
		Background,
		TweenInfo.new(FadeDuration),
		{
			ImageTransparency = 1,
			BackgroundTransparency = 1
		}
	):Play()

	task.wait(FadeDuration)

	-- Remove UI
	if ScreenGui then
		ScreenGui:Destroy()
	end

	-- Restore camera
	if Camera then
		Camera.CameraType = Enum.CameraType.Custom
		Camera.FieldOfView = StartFOV
	end

	-- Set death cause
	local GameStats = game:GetService("ReplicatedStorage"):FindFirstChild("GameStats")

	if GameStats then
		local Stats = GameStats:FindFirstChild("Player_" .. Player.Name)

		if Stats then
			local Total = Stats:FindFirstChild("Total")

			if Total then
				local DeathCause = Total:FindFirstChild("DeathCause")

				if DeathCause then
					DeathCause.Value = "Torment"
				end
			end
		end
	end

	DeathSequencePlaying = false
end


